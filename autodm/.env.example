# ── 서버 ──
PORT=8787
# 기본은 이 PC에서만 접속. 같은 와이파이의 휴대폰 등에서 열려면 0.0.0.0
HOST=127.0.0.1
# 터널·다른 기기에서 관리 화면에 들어올 때 쓰는 비밀번호 (비우면 자동으로 만들어 서버 콘솔에 보여 줘요)
ADMIN_PASSWORD=
# 자동화·발송 기록이 저장되는 파일
DATA_FILE=data/db.json

# ── 실제 인스타그램 연동 (비워 두면 데모 모드만 사용) ──
# Meta 개발자 앱 > Instagram > API setup with Instagram login 에서 확인
IG_APP_ID=
IG_APP_SECRET=
# 웹훅 설정 화면에 같은 값을 넣어요 (아무 문자열이나 직접 정하기)
WEBHOOK_VERIFY_TOKEN=
# 외부에서 접근 가능한 HTTPS 주소 (예: cloudflared/ngrok 터널 주소)
PUBLIC_BASE_URL=
# Graph API 버전
IG_GRAPH_VERSION=v23.0

# ── AI 문구 변형 (선택) ──
# 넣으면 DM 편집기에서 "AI로 만들기"로 뜻이 같은 다른 문구를 만들 수 있어요 (Claude API 키)
ANTHROPIC_API_KEY=

# ── 메일 알림 (선택) ──
# 인스타그램 제한 신호·답글 자동 멈춤·연결 끊김을 Gmail로 받아요. 설정 화면에서 넣어도 돼요 (여기 값이 우선).
# 앱 비밀번호: Google 계정 > 보안 > 2단계 인증을 켠 뒤 '앱 비밀번호'에서 만든 16자리
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 받는 주소 (비우면 GMAIL_USER로)
ALERT_EMAIL_TO=
