{
  "name": "caroldm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "인스타그램 댓글 기반 자동 DM 매니저 (SEED Design)",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@karrotmarket/react-monochrome-icon": "^1.35.0",
    "@seed-design/css": "^3.4.0",
    "@seed-design/react": "^3.4.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "nodemailer": "^10.6.1",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seed-design/vite-plugin": "^2.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
